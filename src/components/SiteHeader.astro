---
interface Props { active?: 'about' | 'architecture' }

const { active } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<header class="site-header">
  <a class="wordmark" href={base}>Lens <span>on</span> Security</a>
  <nav class="site-nav" aria-label="Primary navigation">
    <a href={`${base}about/`} aria-current={active === 'about' ? 'page' : undefined}>A cybersecurity journey through photographs.</a>
    <a href={`${base}architecture/`} aria-current={active === 'architecture' ? 'page' : undefined}>Architecture</a>
  </nav>
</header>

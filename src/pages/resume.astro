---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---
<BaseLayout title="Résumé — Abir Rahi" description="View or download Abir Rahi’s résumé.">
  <section class="shell">
    <SiteHeader />

    <main class="resume-page">
      <header class="resume-hero">
        <div>
          <h1>Abir Rahi</h1>
        </div>
        <div class="page-actions">
          <a class="page-button" href="/resume/view/" target="_blank" rel="noopener">Open PDF</a>
          <a class="page-button secondary" href="/resume/abir-rahi-resume.pdf" download>Download PDF</a>
        </div>
      </header>

      <section class="resume-viewer" aria-label="Résumé PDF viewer">
        <iframe class="resume-embed" src="/resume/abir-rahi-resume.pdf#view=FitH" title="Abir Rahi résumé"></iframe>
        <div class="resume-mobile-fallback">
          <p>Open or download the résumé for the best view on a phone or tablet.</p>
          <div class="page-actions">
            <a class="page-button" href="/resume/view/" target="_blank" rel="noopener">Open PDF</a>
            <a class="page-button secondary" href="/resume/abir-rahi-resume.pdf" download>Download PDF</a>
          </div>
        </div>
      </section>
    </main>

    <footer>© 2026 Lens on Security</footer>
  </section>
</BaseLayout>

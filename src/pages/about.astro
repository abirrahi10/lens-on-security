---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { existsSync } from 'node:fs';
import about from '../data/about.json';

const portraitFile = new URL('../../public/images/about/abir-rahi.jpg', import.meta.url);
const resumeFile = new URL('../../public/resume/abir-rahi-resume.pdf', import.meta.url);
const hasPortrait = existsSync(portraitFile);
const hasResume = existsSync(resumeFile);
const initials = about.name.split(/\s+/).map((part) => part[0]).join('').slice(0, 2).toUpperCase();
---
<BaseLayout title={`About ${about.name} — Lens on Security`} description={`Meet ${about.name} and learn why Lens on Security connects cybersecurity concepts with everyday photographs.`}>
  <section class="shell">
    <SiteHeader active="about" />

    <article class="profile-page">
      <header class="profile-hero">
        {hasPortrait ? (
          <img class="portrait-photo" src="/images/about/abir-rahi.jpg" alt={about.portraitAlt} />
        ) : (
          <div class="portrait-placeholder" role="img" aria-label={`Portrait of ${about.name} will be added here`}>
            <span>{initials}</span>
            <small>Portrait coming soon</small>
          </div>
        )}
        <div class="profile-intro">
          <p class="kicker">About the author</p>
          <h1>{about.name}</h1>
          {about.certifications.length > 0 && <p class="profile-role">Certifications: {about.certifications.join(' · ')}</p>}
          {about.links.length > 0 && (
            <nav class="profile-links" aria-label={`${about.name}’s links`}>
              <span>Links:</span>
              {about.links.map((link, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">·</span>}
                  <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
                </>
              ))}
            </nav>
          )}
          <p class="profile-summary">{about.summary}</p>
        </div>
      </header>

      <div class="profile-content">
        <section aria-labelledby="why-title">
          <p class="kicker">Why this exists</p>
          <h2 id="why-title">{about.whyTitle}</h2>
          {about.whyBody.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <aside class="resume-panel" id="resume" aria-labelledby="resume-title">
          <p class="kicker">Résumé</p>
          <h2 id="resume-title">{about.resumeTitle}</h2>
          {hasResume ? (
            <div class="page-actions">
              <a class="page-button" href="/resume/">View résumé</a>
              <a class="page-button secondary" href="/resume/abir-rahi-resume.pdf" download>Download PDF</a>
            </div>
          ) : (
            <span class="page-button unavailable" aria-disabled="true">Résumé coming soon</span>
          )}
        </aside>
      </div>
    </article>

    <SiteFooter />
  </section>
</BaseLayout>
